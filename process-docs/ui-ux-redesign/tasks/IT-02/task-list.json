  "e2e-paths": [
    {
      "id": "PATH-01",
      "name": "菜单快捷键发现与执行",
      "type": "happy",
      "steps": [
        "展开「视图」菜单核对 6 组语义分组与组内项序（功能点：重排顶部菜单分组，任务 FE-01）",
        "逐项比对菜单右侧快捷键提示与实际触发键位（功能点：菜单快捷键回显单源派生，任务 FE-02，AC-FN-07）",
        "按 Ctrl+Shift+T 仅触发 reopenClosedTab 重开标签（功能点：清理 Ctrl+Shift+T 键位归属，任务 FE-03）",
        "按 Ctrl+=/Ctrl+-/Ctrl+0/F12 验证缩放与 DevTools 动作通道 windowZoom/windowToggleDevTools（功能点：补注册缩放与开发者工具键位，任务 FE-03/BE-01）",
        "打开「插入」菜单确认「插入表格…」唯一且含「选区转表格…」（功能点：重排顶部菜单分组，任务 FE-01，menu:insert-dedupe）"
      ]
    },
    {
      "id": "PATH-02",
      "name": "键盘走菜单与子菜单",
      "type": "happy",
      "steps": [
        "Tab 聚焦菜单栏后 ←/→ 展开「文件」菜单（功能点：键盘遍历菜单与子菜单，任务 FE-05）",
        "↑/↓ 遍历菜单项并进入「打开最近」子菜单（功能点：键盘遍历菜单与子菜单，任务 FE-05，AC-RULE-02）",
        "Enter 执行菜单项且行为与点击等效（功能点：键盘遍历菜单与子菜单，任务 FE-05，AC-RULE-09 同源）",
        "按 Esc 关闭菜单且焦点回正文（功能点：键盘遍历菜单与子菜单，任务 FE-05，AC-FN-10）"
      ]
    },
    {
      "id": "PATH-03",
      "name": "左导航键盘阅读链路",
      "type": "happy",
      "steps": [
        "Tab 聚焦文件树，↑/↓ 移动焦点并 Enter 打开文件（功能点：键盘导航文件树，任务 FE-06）",
        "Tab 聚焦大纲，↑/↓ 移动焦点后 Enter 激活跳转（功能点：键盘导航大纲，任务 FE-08）",
        "正文平滑滚动定位标题且大纲项保持 active（功能点：平滑跳转大纲并跟随 active，任务 FE-07，AC-FN-11）",
        "大纲 ←/→ 折叠章节并核对正文同步（功能点：同步大纲与正文折叠，任务 FE-08/FE-09，AC-FN-30）",
        "折叠后切标签再切回并重启应用，折叠保持且 .md 零字节变化（功能点：记忆章节折叠跨重启，任务 FE-09，AC-FN-25）"
      ]
    },
    {
      "id": "PATH-04",
      "name": "空侧栏与误触键位不劫持正文",
      "type": "error",
      "steps": [
        "空工作区聚焦文件树验证无焦点行且键盘事件不劫持正文（功能点：键盘导航文件树，任务 FE-06，filetreeKeys 空树分支）",
        "焦点在正文时按 ↑/↓/Enter 验证不触发侧栏/大纲动作（功能点：键盘导航大纲，任务 FE-08）",
        "大纲叶子节点按 ←/→ 验证不动作不报错（功能点：键盘导航大纲，任务 FE-08）",
        "无可恢复标签时 Ctrl+Shift+T 对应菜单项灰显不执行（功能点：清理 Ctrl+Shift+T 键位归属，任务 FE-03，precondition 灰显）"
      ]
    },
    {
      "id": "PATH-05",
      "name": "窗口边缘菜单全项可达",
      "type": "edge",
      "steps": [
        "窗口贴屏幕右下角展开「视图」15 项菜单（功能点：菜单弹层限高滚动与边缘翻转，任务 FE-04）",
        "验证限高内滚动且全部一级项完整可点（功能点：菜单弹层限高滚动与边缘翻转，任务 FE-04，AC-RULE-10/AC-NF-08）",
        "hover 子菜单项间移动不闪烁、移回父项收拢（功能点：菜单弹层限高滚动与边缘翻转，任务 FE-04，AC-FN-08）",
        "窗口缩至 640×400 再展开菜单验证无裁切不可达（功能点：菜单弹层限高滚动与边缘翻转，任务 FE-04，AC-ERR-09）"
      ]
    },
    {
      "id": "PATH-06",
      "name": "折叠记忆失效清洗与取舍对账",
      "type": "edge",
      "steps": [
        "折叠某二级章节后删除该标题，验证失效 foldKey 被 useFoldSync 清洗（功能点：记忆章节折叠跨重启，任务 FE-09）",
        "重启应用验证剩余折叠保持且 .md 逐字节不变（功能点：记忆章节折叠跨重启，任务 FE-09，AC-FN-25）",
        "深浅主题各一遍核对侧栏焦点环/三态 token（功能点：审计侧栏视觉 token，任务 FE-10，AC-FN-12）",
        "对照取舍清单核对 NAV-GAPS-SORT/MSLT 标注不实现、KBRD 已落地（功能点：登记功能缺口取舍，任务 FE-11，AC-FN-13）"
      ]
    }
  ],
