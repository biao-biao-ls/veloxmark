  "e2e-paths": [
    {
      "id": "PATH-01",
      "name": "表格评审改稿主链路（插/移行列与对齐 + toast 撤销）",
      "type": "happy",
      "steps": [
        "打开含表格的 .md，点击单元格进入编辑态（功能点：表格编辑态进入与退出，FE-04）",
        "按 Ctrl+Enter 在下方插行，toast「已在下方插入行（Ctrl+Z 可撤销）」出现（功能点：快捷键四向插行列与移行列，FE-02）",
        "按 Ctrl+Shift+→ 在右侧插列，冒号行新增左对齐项（FE-02，AC-OP-03）",
        "按 Alt+↓ 下移当前行，列对齐不变（FE-01/FE-02）",
        "⋮ 菜单点「居中对齐」，第 j 列对齐改写并回显「第 j 列对齐：居中（Ctrl+Z 可撤销）」（功能点：对齐三键切换，FE-04）",
        "点 toast 撤销按钮，一步还原对齐改动，回执「已撤销」（功能点：操作 toast 回执与撤销按钮，FE-07）"
      ]
    },
    {
      "id": "PATH-02",
      "name": "删表确认与一步还原",
      "type": "happy",
      "steps": [
        "工具栏点 🗑（data-op deleteTable），弹确认框文案「删除后可用一步撤销还原，确认删除该表格」（功能点：删除表格确认框，FE-08）",
        "点确认删除按钮，整表从源码移除，toast「已删除表格（Ctrl+Z 可撤销）」（AC-OP-09）",
        "点 toast 撤销按钮，整表一步还原逐字节一致（FE-07/FE-08）"
      ]
    },
    {
      "id": "PATH-03",
      "name": "⊞ 超限表缩放主链路",
      "type": "happy",
      "steps": [
        "打开 25×15 超限表进入编辑态，点工具栏 ⊞（data-op resizeTable）（功能点：⊞ 网格拖选缩放，FE-05）",
        "核对网格上界为 25×15（max(20,R0)×max(12,C0)，AC-ERR-13）",
        "拖选 4×3 松手，源码表缩放为 4×3，toast「表格缩放为 4×3（Ctrl+Z 可撤销）」（AC-OP-07）",
        "Ctrl+Z 一次还原原 25×15 表（AC-RULE-12 单事务）"
      ]
    },
    {
      "id": "PATH-04",
      "name": "参差表与表头迁移边界链路",
      "type": "edge",
      "steps": [
        "构造参差表（各行单元格数不等），点击首行单元格进入编辑态（功能点：参差表格补齐矩形，FE-01）",
        "按 Ctrl+Shift+Enter 首行上插：新空行升为表头，原表头降级 body 首行，冒号行仍第 2 行（AC-OP-02/Q5）",
        "任一结构操作后全表补齐为矩形，内容不错位（AC-ERR-01/PEND-07）",
        "Ctrl+Z 一次还原含表头身份与参差态逐字节一致（AC-RULE-07/08）"
      ]
    },
    {
      "id": "PATH-05",
      "name": "禁用态与键族不劫持异常链路",
      "type": "error",
      "steps": [
        "打开 1×1 表，⋮ 菜单核对「删除行/删除列」灰显禁用（AC-ERR-02/05，功能点：⋮/右键同源菜单，FE-04）",
        "首行打开菜单核对「上移该行」灰显，点击禁用项不执行、无 toast 报错、无异常弹窗（AC-ERR-05/06）",
        "焦点移至正文段落按 Ctrl+Enter/Ctrl+Shift+←→/Alt+↑↓←→，无结构变化、不弹工具栏（AC-ERR-12，FE-02）",
        "只读文件触发结构操作被拒并 toast「文件为只读，无法修改，可另存后编辑」（tech-design.md#10-异常处理）"
      ]
    },
    {
      "id": "PATH-06",
      "name": "删表取消与模态叠加异常链路",
      "type": "error",
      "steps": [
        "🗑 弹删表确认框后按 Esc，仅关框不删除（AC-ERR-07/PEND-04，功能点：删除表格确认框，FE-08）",
        "再次弹确认框并打开 ⋮ 菜单叠加，核对确认框恒为最上层（功能点：一键回安静与模态叠加，FE-09）",
        "点遮罩空白仅关确认框，零副作用（表未删、无 toast、无 undo 条目）",
        "无确认框时按 Esc 一次收拢全部浮层 chrome，焦点回正文（AC-FN-21/29）"
      ]
    },
    {
      "id": "PATH-07",
      "name": "列宽吸收与去把手静息链路",
      "type": "happy",
      "steps": [
        "hover 表格，核对四周无 +/− 增删把手、左缘与正文列偏移 0px（功能点：去增删把手与左侧留白，FE-03，AC-FN-01/02）",
        "拖拽中间列右边界，两列宽此消彼长、表格总宽不变（功能点：列宽拖拽右邻吸收，FE-06，AC-OP-11）",
        "拖拽最右列右边界，总宽增减且钳制正文列内（PEND-10）",
        "DOM 扫描 data-table-handle 集合 = {col-grip}，工具栏/⋮ data-op 集合与 opsTable 19 项一致（AC-RULE-17，INFRA-01）"
      ]
    },
    {
      "id": "PATH-08",
      "name": "toast 驻留/防抖/i18n 全局链路",
      "type": "edge",
      "steps": [
        "删除一行，toast「已删除第 i 行（Ctrl+Z 可撤销）」驻留 5s 后自动消失（功能点：操作 toast 回执与撤销按钮，FE-07，AC-OP-12）",
        "连续两次操作，toast 顶替为最新回执且计时重置（FE-07 队列）",
        "快速划过表格不闪烁/半途浮现，慢速 hover ≥150ms 才浮现（功能点：静息零 chrome 与防抖零抖动，FE-10，AC-NF-04）",
        "chrome 显隐前后正文位移 0px（AC-NF-05）",
        "切换中英语言，toast/确认框冻结文案经 i18n key 完整渲染无缺 key（功能点：冻结文案 i18n 与样式 token，FE-11，AC-FN-28）"
      ]
    }
  ],
